{
  "name": "agent-tab",
  "version": "0.2.0",
  "description": "CLI that prints today's token usage and cost across Claude Code, Codex CLI, and Gemini CLI. Designed to wire into Claude Code's statusLine so the active agent's tab shows above your prompt.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agent-tab": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/pricing.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "statusline",
    "tokens",
    "cost",
    "cli",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikar0805/agent-tab.git"
  },
  "homepage": "https://github.com/srikar0805/agent-tab#readme",
  "bugs": {
    "url": "https://github.com/srikar0805/agent-tab/issues"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
