{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["./**/*"],
  "exclude": ["../dist", "../node_modules"]
}
